{
  "name": "thai-customs-tariff-json",
  "version": "1.0.0",
  "description": "Parse Thai Customs (ITD) tariff master files into bilingual Thai/English JSON: WTO, FTA, ATIGA, Section 12 rates and import permits by HS code.",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:fta-dictionary && npm run build:fta && npm run build:wto && npm run build:asean && npm run build:section12 && npm run build:section12-clause2 && npm run build:section12-clause3 && npm run build:emergency-decree && npm run build:permits",
    "build:fta-dictionary": "node src/extract_fta_privilege_codes.js -b ./src/raw-data -o ./output/fta_privilege_dictionary.json",
    "build:fta": "node src/build_fta_full_data.js -b ./src/raw-data -o ./output/fta_json",
    "build:wto": "node src/build_wto_rates.js -b ./src/raw-data -o ./output/wto_json",
    "build:asean": "node src/build_asean_atiga_rates.js -b ./src/raw-data -o ./output/asean_json",
    "build:section12": "node src/build_section12_rates.js -b ./src/raw-data -o ./output/section12_json",
    "build:section12-clause2": "node src/build_section12_clause2_rates.js -b ./src/raw-data -o ./output/section12_clause2_json",
    "build:section12-clause3": "node src/build_section12_clause3_rates.js -b ./src/raw-data -o ./output/section12_clause3_json",
    "build:emergency-decree": "node src/build_emergency_decree_rates.js -b ./src/raw-data -o ./output/emergency_decree_json",
    "build:permits": "node src/build_electronic_permits.js -i ./src/raw-data/REFPMG_Open.txt -o ./output/permit_json",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "thailand",
    "customs",
    "tariff",
    "hs-code",
    "fta",
    "wto",
    "atiga",
    "trade",
    "json"
  ],
  "author": "Soe-Moe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Soe-Moe/thai-customs-tariff-json.git"
  },
  "homepage": "https://github.com/Soe-Moe/thai-customs-tariff-json#readme",
  "bugs": {
    "url": "https://github.com/Soe-Moe/thai-customs-tariff-json/issues"
  },
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3"
  }
}
